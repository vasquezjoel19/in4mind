# ── Supabase (públicas en el cliente — usa la clave "anon", nunca la service_role) ──
# Dashboard: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Groq (SECRETA — solo en Vercel Environment Variables, nunca en el navegador) ──
# Consola: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_secreta_aqui

# Opcionales
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1200
GROQ_TEMPERATURE=0.45

# ── Recuperación de contraseña (Resend) — SECRETA, solo en el servidor ──
# Sin estas variables /api/auth/request-reset responde 503 y la app
# avisa que el correo no se envió (no finge el envío).
# Consola: https://resend.com/api-keys
RESEND_API_KEY=re_tu_clave_secreta_aqui
# Remitente verificado en Resend, p. ej. "IN4MIND <no-reply@tu-dominio.com>"
RESET_FROM_EMAIL=IN4MIND <no-reply@tu-dominio.com>
# URL pública del sitio. En Vercel se usa VERCEL_URL automáticamente;
# define PUBLIC_BASE_URL solo fuera de Vercel (dev local / otro host).
PUBLIC_BASE_URL=https://tu-dominio.com
