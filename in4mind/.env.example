# ── Supabase (públicas en el cliente — usa la clave "anon", nunca la service_role) ──
# Dashboard: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Groq (SECRETA — solo en Vercel Environment Variables, nunca en el navegador) ──
# Consola: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_secreta_aqui

# Opcionales
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1200
GROQ_TEMPERATURE=0.45
