# ── Supabase (públicas en el cliente — usa la clave "anon", nunca la service_role) ──
# Dashboard: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Verificación de sesión en las funciones serverless (SECRETA) ──
# /api/groq/chat exige "Authorization: Bearer <jwt de Supabase>". Con el JWT
# Secret la verificación es local (sin red); sin él se valida contra
# /auth/v1/user usando SUPABASE_ANON_KEY, más lento pero compatible con las
# claves asimétricas nuevas.
# Sin ninguna de las dos, /api/groq/chat responde 503 AUTH_NOT_CONFIGURED:
# falla cerrado a propósito, nunca deja el proxy abierto.
# Dashboard: Project Settings → API → JWT Secret
# Comprueba tras desplegar: /api/health → { "auth": true }
SUPABASE_JWT_SECRET=tu_jwt_secret_de_supabase

# ── Groq (SECRETA — solo en Vercel Environment Variables, nunca en el navegador) ──
# Consola: https://console.groq.com/keys
# Formato esperado: "gsk_" seguido del token, sin comillas ni espacios sobrantes.
# Verifica tras desplegar:
#   /api/health        → { "groq": true }            (variable configurada)
#   /api/groq/ping     → { "ok": true, "latencyMs" } (la clave funciona de verdad)
GROQ_API_KEY=gsk_tu_clave_secreta_aqui

# Opcionales
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1200
GROQ_TEMPERATURE=0.45

# ── Límite de uso del asistente, por usuario (0 desactiva) ──
# Exigir sesión no impide que alguien se registre y llame en bucle.
#   PER_MIN: ráfaga, en memoria de cada instancia. Corta bucles al instante.
#   PER_DAY: cuota compartida en Supabase; es la que protege la cuota de Groq.
#            Necesita SUPABASE_URL + SUPABASE_ANON_KEY y la migración
#            supabase/migrations/20260921_ai_usage_quota.sql.
# Comprueba tras desplegar: /api/health → rateLimit.quota === true
GROQ_RATE_LIMIT_PER_MIN=15
GROQ_RATE_LIMIT_PER_DAY=200

# ── Recuperación de contraseña ──
# No hace falta ninguna variable: el correo lo envía Supabase Auth con su
# propio token de un solo uso. Configura plantilla y remitente en
# Supabase → Authentication → Emails, y añade la URL de la app en
# Authentication → URL Configuration → Redirect URLs.
#
# El endpoint propio /api/auth/request-reset se eliminó: aceptaba cualquier
# destinatario y cualquier token del cliente, así que era un relé de correo
# abierto a nombre del dominio de IN4MIND.
